# If not running interactively, don't do anything
[[ $- == *i* ]] || return

# Server prompt — same bracket format as the local .bash_prompt, but the HOST is
# red so you can tell at a glance you're on a remote box (not your Mac).
white='\[\033[1;37m\]'
green='\[\033[1;32m\]'
blue='\[\033[1;34m\]'
red='\[\033[1;31m\]'
reset='\[\033[0m\]'

# [user@host dir]$   — host in red = remote
PS1="${white}[${green}\u${white}@${red}\h ${blue}\W${white}]${reset}\$ "
